          ],
          "properties": {
            "algorithm": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          }
        }
      }
    },
    "custody_event": {
      "type": "object",
      "required": [
        "id",
        "type",
        "evidence",
        "action",
        "timestamp",
        "actor"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "custody_event"
        },
        "evidence": {
          "$ref": "#/$defs/ref"
        },
        "action": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        },
        "actor": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "manifest": {
      "type": "object",
      "required": [
        "id",
        "type",
        "experiment",
        "evidence"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
