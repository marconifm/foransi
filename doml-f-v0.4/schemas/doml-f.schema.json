    "relation": {
      "type": "object",
      "required": [
        "type",
        "source",
        "target"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "requires",
            "depends_on",
            "provides",
            "connects_to",
            "hosts",
            "uses",
            "collects",
            "attacks",
            "observes",
            "generates",
            "derived_from",
            "contains"
          ]
        },
        "source": {
          "$ref": "#/$defs/ref"
        },
        "target": {
          "$ref": "#/$defs/ref"
        }
      }
    }
