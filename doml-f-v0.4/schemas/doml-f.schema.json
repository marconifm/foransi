{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/doml-f/0.1/schema.json",
  "title": "DOML-F 0.1",
  "type": "object",
  "required": [
    "doml",
    "metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "doml": {
      "type": "object",
      "required": [
        "language",
        "version",
        "schema"
      ],
      "additionalProperties": false,
      "properties": {
        "language": {
          "const": "DOML-F"
        },
        "version": {
          "type": "string",
          "pattern": "^0\\.1(?:\\.\\d+)?$"
        },
        "schema": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "model_version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "environment_version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provider"
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/objective"
      }
    },
    "use_cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/use_case"
      }
    },
    "networks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/network"
      }
    },
    "storage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/storage"
      }
    },
    "images": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/image"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "identities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identity"
      }
    },
    "services": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/service"
      }
    },
    "telemetry": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/telemetry"
      }
    },
    "hardening": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hardening"
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "attacks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attack"
      }
    },
    "baselines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/baseline"
      }
    },
    "ground_truth": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ground_truth"
      }
    },
    "collections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/collection"
      }
    },
    "experiments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/experiment"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "custody_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/custody_event"
      }
    },
    "manifests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/manifest"
      }
    },
    "validations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validation"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    }
