        },
        "expected_artifacts": {
          "type": "array"
        }
      }
    },
    "attack": {
      "type": "object",
      "required": [
        "id",
        "type",
        "scenario",
        "source",
        "target"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string"
        },
        "scenario": {
          "$ref": "#/$defs/ref"
        },
        "source": {
          "$ref": "#/$defs/ref"
        },
        "target": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "baseline": {
      "type": "object",
      "required": [
        "id",
        "type",
        "model"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "baseline"
        },
        "model": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "ground_truth": {
      "type": "object",
      "required": [
        "id",
        "type",
        "experiment"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "ground_truth"
        },
        "experiment": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "collection": {
      "type": "object",
      "required": [
        "id",
        "type",
        "experiment"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "collection"
        },
        "experiment": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "experiment": {
      "type": "object",
      "required": [
        "id",
        "type",
        "model",
        "scenario",
        "baseline"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "experiment"
        },
        "model": {
          "$ref": "#/$defs/ref"
        },
        "scenario": {
          "$ref": "#/$defs/ref"
        },
        "baseline": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "type",
        "experiment",
        "source",
        "collected_at",
        "method",
        "hash"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "evidence"
        },
        "experiment": {
          "$ref": "#/$defs/ref"
