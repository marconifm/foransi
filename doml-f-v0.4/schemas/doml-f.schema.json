          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "physical",
            "container",
            "vm"
          ]
        },
        "role": {
          "type": "string"
        }
      }
    },
    "identity": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string"
