      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string"
        }
      }
    },
    "hardening": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string"
        }
      }
    },
    "scenario": {
      "type": "object",
      "required": [
        "id",
        "type",
        "objective",
        "success_criteria",
        "failure_criteria"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string"
        },
        "objective": {
          "type": "string"
        },
        "success_criteria": {
          "type": "array",
          "minItems": 1
