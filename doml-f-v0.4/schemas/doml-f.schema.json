        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string"
        },
        "node": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "telemetry": {
      "type": "object",
      "required": [
        "id",
