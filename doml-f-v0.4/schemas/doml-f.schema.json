      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "network"
        },
        "purpose": {
          "enum": [
            "management",
            "target",
            "attack",
            "evidence"
          ]
        }
      }
    },
    "storage": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string"
        }
      }
